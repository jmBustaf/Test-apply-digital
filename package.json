{
  "name": "test-products",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:file": "prettier --write",
    "lint:file": "eslint --ext .ts --fix",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main.js",
    "lint": "eslint . --ext .ts",
    "test": "jest --config jest.unit.config.ts",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:unit:watch": "jest --config jest.unit.config.ts --watch",
    "test:unit:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config jest.unit.config.ts --runInBand",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:integration:watch": "jest --config jest.integration.config.ts --watch",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "test:e2e:watch": "jest --config jest.e2e.config.ts --watch",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test:unit -- --coverage --watchAll=false && npm run test:integration -- --coverage --watchAll=false && npm run test:e2e -- --coverage --watchAll=false",
    "test:cov": "npm run test:unit -- --coverage && npm run test:integration -- --coverage && npm run test:e2e -- --coverage",
    "test:cov:unit": "jest --config jest.unit.config.ts --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=html",
    "test:cov:integration": "jest --config jest.integration.config.ts --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=html",
    "test:cov:e2e": "jest --config jest.e2e.config.ts --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=html",
    "test:watch": "npm run test:unit:watch",
    "test:debug": "npm run test:unit:debug",
    "prepare": "husky install",
    "docker:build": "docker build -t test-products .",
    "docker:build:dev": "docker build --target development -t test-products:dev .",
    "docker:run": "docker run -p 3000:3000 --env-file .env test-products",
    "docker:run:dev": "docker run -p 3000:3000 --env-file .env -v $(pwd):/app test-products:dev",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:up:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:down:dev": "docker-compose -f docker-compose.dev.yml down",
    "docker:compose:logs": "docker-compose logs -f",
    "docker:compose:logs:dev": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:compose:build": "docker-compose build",
    "docker:compose:build:dev": "docker-compose -f docker-compose.dev.yml build",
    "docker:compose:restart": "docker-compose restart",
    "docker:compose:restart:dev": "docker-compose -f docker-compose.dev.yml restart"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "contentful": "^11.7.19",
    "cron": "^4.3.3",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.44.1"
  }
}
